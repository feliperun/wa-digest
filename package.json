{
  "name": "wa-digest",
  "version": "0.1.0",
  "description": "Companion digest service for Evolution API webhooks and agent-ready WhatsApp timelines.",
  "type": "module",
  "homepage": "https://github.com/feliperun/wa-digest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feliperun/wa-digest.git"
  },
  "bugs": {
    "url": "https://github.com/feliperun/wa-digest/issues"
  },
  "bin": {
    "wa-digest": "./dist/cli.js",
    "digestctl": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "doctor": "tsx src/cli.ts doctor",
    "quality": "sentrux check ."
  },
  "keywords": [
    "evolution-api",
    "whatsapp",
    "openclaw",
    "soniox",
    "transcription",
    "media-digest"
  ],
  "license": "MIT",
  "dependencies": {
    "@soniox/node": "^2.1.0",
    "express": "^4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example",
    "examples",
    "docs/adr",
    "docs/ARCHITECTURE.md",
    "docs/GETTING-STARTED.md",
    "docs/PLAN.md",
    "docs/VISION.md",
    "openclaw/skills"
  ]
}
