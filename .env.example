MEDIA_DOWNLOAD_TIMEOUT_MS=30000
TRANSCRIPTION_ALLOWED_MIME_TYPES=audio/*,video/*
MAX_TRANSCRIPTION_MINUTES_PER_DAY=0

VISION_PROVIDER=metadata
VISION_BASE_URL=
