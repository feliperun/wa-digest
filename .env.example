PORT=3897
DIGEST_API_TOKEN=change-me

EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE=monitor

DATABASE_URL=postgresql://evo:change-me@127.0.0.1:5432/evolution
